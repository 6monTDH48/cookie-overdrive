        "OutdoorAmbient": [
          0.4,
          0.25,
          0.6
        ]
      }
    },
    "Workspace": {
      "$properties": {
        "Gravity": 196.2
      }
    },
    "Players": {
      "$properties": {
        "CharacterAutoLoads": false
      }
    }
  }
