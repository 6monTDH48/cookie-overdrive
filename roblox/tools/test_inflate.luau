--!nonstrict
--[[
	Tests + benchmark for src/shared/Inflate.lua (zlib/DEFLATE + base64), Luau CLI only:

	    /home/user/tools/luau roblox/tools/test_inflate.luau                  (interpreter, -O1)
	    /home/user/tools/luau -O2 roblox/tools/test_inflate.luau              (like live Roblox)
	    /home/user/tools/luau -O2 --codegen roblox/tools/test_inflate.luau    (native, like --!native)

	Fixtures: tests/fixtures.luau, produced by tests/make_fixtures.py with Python's zlib.
	If src/shared/ImageData exists (generated by pack_assets.py), every image module is also
	decoded with adler32 verification and its size checked.
	Non-zero exit code if anything fails.
]]

local Inflate = require("../src/shared/Inflate")
local fixtures = require("./tests/fixtures")

local failures, passes = 0, 0
local function check(cond, msg)
	if cond then
		passes += 1
	else
		failures += 1
		print("FAIL: " .. msg)
	end
end

--------------------------------------------------------------------------------------------
-- independent reference helpers (slow, simple)
--------------------------------------------------------------------------------------------
local ALPHA = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
local REV = {}
for i = 1, 64 do
	REV[string.sub(ALPHA, i, i)] = i - 1
end

local function refB64Decode(s)
	s = string.gsub(s, "=", "")
	local out = table.create(#s)
	local acc, nbits = 0, 0
	for i = 1, #s do
		acc = acc * 64 + REV[string.sub(s, i, i)]
		nbits += 6
		if nbits >= 8 then
			nbits -= 8
			local b = acc // (2 ^ nbits)
			table.insert(out, string.char(b))
			acc -= b * 2 ^ nbits
		end
	end
	return table.concat(out)
end

local function refB64Encode(s, withPad)
	local out = {}
	for i = 1, #s, 3 do
		local a, b, c = string.byte(s, i, i + 2)
		local n = a * 65536 + (b or 0) * 256 + (c or 0)
		local chars = 2 + (b and 1 or 0) + (c and 1 or 0)
		for k = 1, 4 do
			if k <= chars then
				local v = (n // (2 ^ (6 * (4 - k)))) % 64
				table.insert(out, string.sub(ALPHA, v + 1, v + 1))
			elseif withPad then
				table.insert(out, "=")
			end
		end
	end
	return table.concat(out)
end

local CRC = table.create(256, 0)
for n = 0, 255 do
	local c = n
	for _ = 1, 8 do
		if bit32.band(c, 1) ~= 0 then
			c = bit32.bxor(0xEDB88320, bit32.rshift(c, 1))
		else
			c = bit32.rshift(c, 1)
		end
	end
	CRC[n + 1] = c
end
local function crc32(b, len)
	local c = 0xFFFFFFFF
	for i = 0, len - 1 do
		c = bit32.bxor(CRC[bit32.band(bit32.bxor(c, buffer.readu8(b, i)), 255) + 1], bit32.rshift(c, 8))
	end
	return bit32.bxor(c, 0xFFFFFFFF)
end

--------------------------------------------------------------------------------------------
-- base64
--------------------------------------------------------------------------------------------
do
	local vectors = { "", "f", "fo", "foo", "foob", "fooba", "foobar" }
	for _, v in vectors do
		for _, pad in { true, false } do
			local enc = refB64Encode(v, pad)
			local b, n = Inflate.base64(enc)
			check(n == #v and buffer.len(b) >= n, "base64 length for '" .. v .. "'")
			check(buffer.readstring(b, 0, n) == v, "base64 content for '" .. v .. "' pad=" .. tostring(pad))
		end
	end
	check(refB64Encode("foobar", true) == "Zm9vYmFy" and refB64Encode("fo", true) == "Zm8=", "reference encoder")
	local all = {}
	for i = 0, 255 do
		all[i + 1] = string.char(i)
	end
	local s = table.concat(all)
	s = s .. string.reverse(s) .. s
	for cut = 0, 3 do
		local part = string.sub(s, 1, #s - cut)
		local b, n = Inflate.base64(refB64Encode(part, true), 8)
		check(n == #part and buffer.readstring(b, 0, n) == part, "base64 all bytes, cut " .. cut)
		check(buffer.len(b) == n + 8 and buffer.readu32(b, n) == 0 and buffer.readu32(b, n + 4) == 0, "base64 zero padding")
	end
	check(not pcall(Inflate.base64, "Zm9v!mFy"), "base64 rejects invalid characters")
	check(not pcall(Inflate.base64, "Zm9vY"), "base64 rejects length 4k+1")
	-- big random string, decoded in chunks with yields
	local parts = {}
	local seed = 12345
	for i = 1, 300000 do
		seed = (seed * 1103515245 + 12345) % 2147483648
		parts[i] = string.char(seed // 8388608)
	end
	local big = table.concat(parts)
	local yields = 0
	local b, n = Inflate.base64(refB64Encode(big, true), 0, { yield = function() yields += 1 end, budget = 0 })
	check(n == #big and buffer.readstring(b, 0, n) == big, "base64 300 KB random")
	check(yields > 0, "base64 yields when budget exceeded")
end

--------------------------------------------------------------------------------------------
-- zlib / deflate fixtures
--------------------------------------------------------------------------------------------
local function decodeCase(c, opts)
	local comp, clen = Inflate.base64(c.z, 8)
	opts = opts or {}
	opts.length = clen
	if c.mode == "raw" then
		local out, n, consumed = Inflate.inflate(comp, opts)
		assert(consumed == clen, "raw deflate consumed " .. consumed .. " of " .. clen)
		return out, n
	else
		local out = Inflate.zlib(comp, opts)
		return out, buffer.len(out)
	end
end

for _, c in fixtures do
	local ok, err = pcall(function()
		-- 1) exact size known (the Img path) + adler32 verification
		local out, n = decodeCase(c, { size = c.n, verify = true })
		check(n == c.n, c.name .. ": size " .. n .. " ~= " .. c.n)
		check(crc32(out, n) == c.crc, c.name .. ": crc32 mismatch")
		if c.raw then
			check(buffer.tostring(out) == refB64Decode(c.raw), c.name .. ": bytes differ")
		end
		-- 2) unknown size (growing output)
		local out2, n2 = decodeCase(c, nil)
		check(n2 == c.n and buffer.len(out2) == c.n, c.name .. ": growing size")
		check(crc32(out2, n2) == c.crc, c.name .. ": growing crc32 mismatch")
		-- 3) time-sliced (yield every check)
		local y = 0
		local out3, n3 = decodeCase(c, { size = c.n, yield = function() y += 1 end, budget = 0 })
		check(n3 == c.n and crc32(out3, n3) == c.crc, c.name .. ": yielding decode")
		check(y > 0, c.name .. ": yield callback called")
		-- 4) wrong expected size must error
		if c.n > 0 then
			check(not pcall(decodeCase, c, { size = c.n - 1 }), c.name .. ": too-small size must error")
		end
		check(not pcall(decodeCase, c, { size = c.n + 1 }), c.name .. ": too-large size must error")
	end)
	if not ok then
		failures += 1
		print("FAIL: " .. c.name .. ": " .. tostring(err))
	end
end

-- corrupted streams must raise an error (never hang or return garbage silently)
do
	local c
	for _, f in fixtures do
		if f.name == "rgba 256x256" then
			c = f
		end
	end
	local comp, clen = Inflate.base64(c.z, 8)
	check(not pcall(Inflate.zlib, comp, { length = clen // 2, size = c.n }), "truncated stream errors")
	check(not pcall(Inflate.zlib, comp, { length = clen // 2 }), "truncated stream errors (growing)")
	local bad = buffer.create(clen + 8)
	buffer.copy(bad, 0, comp, 0, clen)
	buffer.writeu8(bad, 0, 0x79) -- bad header
	check(not pcall(Inflate.zlib, bad, { length = clen }), "bad zlib header errors")
	buffer.copy(bad, 0, comp, 0, clen)
	buffer.writeu8(bad, clen - 1, bit32.bxor(buffer.readu8(bad, clen - 1), 1))
	check(not pcall(Inflate.zlib, bad, { length = clen, size = c.n, verify = true }), "adler32 mismatch detected")
	-- random bit flips: must either error or produce some output; never hang
	local seed = 99
	local errs = 0
	for _ = 1, 60 do
		buffer.copy(bad, 0, comp, 0, clen)
		seed = (seed * 1103515245 + 12345) % 2147483648
		local pos = 2 + seed % (clen - 6)
		buffer.writeu8(bad, pos, bit32.bxor(buffer.readu8(bad, pos), bit32.lshift(1, seed % 8)))
		if not pcall(Inflate.zlib, bad, { length = clen, size = c.n, verify = true }) then
			errs += 1
		end
	end
	check(errs == 60, "all 60 bit-flipped streams rejected (" .. errs .. ")")
end

--------------------------------------------------------------------------------------------
-- real ImageData modules (if pack_assets.py has been run)
--------------------------------------------------------------------------------------------
local okIndex, index = pcall(require, "../src/shared/ImageData/_index")
local realCookie = nil
if okIndex and type(index) == "table" then
	local keys = {}
	for k in index do
		table.insert(keys, k)
	end
	table.sort(keys)
	local t0 = os.clock()
	local rawTotal, zTotal = 0, 0
	for _, key in keys do
		local ok, err = pcall(function()
			local m = require("../src/shared/ImageData/" .. index[key])
			assert(m.key == key, "module key " .. tostring(m.key))
			assert(m.w >= 1 and m.h >= 1 and m.w <= 1024 and m.h <= 1024, "bad size")
			local out = Inflate.base64Zlib(m.z, { size = m.w * m.h * 4, verify = true })
			assert(buffer.len(out) == m.w * m.h * 4)
			rawTotal += buffer.len(out)
			zTotal += #m.z
			if m.w == 640 and m.h == 640 and (realCookie == nil or key == "cookie:classic") then
				realCookie = m
			end
		end)
		check(ok, "ImageData " .. key .. ": " .. tostring(err))
	end
	print(string.format("ImageData: %d images verified (adler32), %.1f MB RGBA from %.1f MB base64 in %.2f s",
		#keys, rawTotal / 1048576, zTotal / 1048576, os.clock() - t0))
else
	print("ImageData/_index not found: skipping real image checks (run tools/pack_assets.py)")
end

print(string.format("\n%d checks passed, %d failed", passes, failures))

--------------------------------------------------------------------------------------------
-- benchmark: 640x640 RGBA decode
--------------------------------------------------------------------------------------------
local function bench(label, z, size)
	local N = 8
	-- warm-up
	Inflate.base64Zlib(z, { size = size })
	local tb, ti = 0, 0
	for _ = 1, N do
		local t0 = os.clock()
		local comp, n = Inflate.base64(z, 8)
		local t1 = os.clock()
		Inflate.zlib(comp, { length = n, size = size })
		local t2 = os.clock()
		tb += t1 - t0
		ti += t2 - t1
	end
	tb /= N
	ti /= N
	local mb = size / 1048576
	print(string.format("%-34s base64 %6.2f ms (%5.0f MB/s in) | inflate %6.2f ms (%5.1f MB/s out) | total %6.2f ms (%5.1f MB/s)",
		label, tb * 1000, #z / 1048576 / tb, ti * 1000, mb / ti, (tb + ti) * 1000, mb / (tb + ti)))
end

print("\nBenchmark (average of 8 runs, output = RGBA bytes):")
for _, c in fixtures do
	if c.bench then
		bench("synthetic cookie 640x640 (" .. math.floor(#c.z / 1024) .. " KB b64)", c.z, c.n)
	end
	if c.name == "rgba 256x256" then
		bench("synthetic 256x256 (" .. math.floor(#c.z / 1024) .. " KB b64)", c.z, c.n)
	end
end
if realCookie then
	bench(string.format("%s %dx%d (%d KB b64)", realCookie.key, realCookie.w, realCookie.h, #realCookie.z // 1024),
		realCookie.z, realCookie.w * realCookie.h * 4)
end

if failures > 0 then
	error(failures .. " test(s) failed", 0) -- non-zero exit code (the Luau CLI has no os.exit)
end
