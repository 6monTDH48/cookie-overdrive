--!nocheck
-- Minimal headless Roblox emulation for Cookie Overdrive (run with /home/user/tools/luau).
-- Validates every Instance property read/write, method call and Enum access against the official
-- type definitions (out/api.luau, generated by gen.py). Virtual clock, task scheduler, deferred
-- signals, in-process RemoteEvent/RemoteFunction with argument serialization.
local API = require("./out/api")
local BUNDLE = require("./out/bundle")

local M = {}
M.errors, M.warns, M.logs = {}, {}, {}
local realType, realTypeof = type, typeof

---------------------------------------------------------------------------------- findings
local function finding(kind, msg)
	local list = kind == "error" and M.errors or M.warns
	for _, f in list do
		if f.msg == msg then f.n += 1; return end
	end
	table.insert(list, { msg = msg, n = 1 })
	print(string.format("[%s] %s", string.upper(kind), msg))
end
M.finding = finding

---------------------------------------------------------------------------------- type tags
local TAG = setmetatable({}, { __mode = "k" }) -- object -> roblox type name
local function mtype(v)
	local t = TAG[v]
	if t then return t end
	return realTypeof(v)
end
local function mtypeRaw(v)
	if TAG[v] then return "userdata" end
	return realType(v)
end
M.typeof, M.type = mtype, mtypeRaw

local function newType(name, fields, mt)
	local o = setmetatable(fields, mt)
	TAG[o] = name
	return o
end

---------------------------------------------------------------------------------- datatypes
local function num(v, what)
	if v == nil then return 0 end
	if realType(v) ~= "number" then error(string.format("invalid argument to %s (number expected, got %s)", what, mtype(v)), 3) end
	return v
end
local function ro(name) return function(_, k) error(string.format("%s cannot be assigned to", tostring(k)), 2) end end

local V2 = {}
local V2mt = { __newindex = ro("Vector2"), __type = "Vector2" }
local function v2(x, y) return newType("Vector2", { X = x, Y = y }, V2mt) end
V2mt.__index = function(s, k)
	if k == "Magnitude" then return math.sqrt(s.X * s.X + s.Y * s.Y) end
	if k == "Unit" then local m = math.sqrt(s.X * s.X + s.Y * s.Y); return m > 0 and v2(s.X / m, s.Y / m) or v2(0 / 0, 0 / 0) end
	if k == "Lerp" then return function(a, b, t) return v2(a.X + (b.X - a.X) * t, a.Y + (b.Y - a.Y) * t) end end
	if k == "Dot" then return function(a, b) return a.X * b.X + a.Y * b.Y end end
	if k == "x" then return s.X elseif k == "y" then return s.Y end
	error(tostring(k) .. " is not a valid member of Vector2", 2)
end
V2mt.__add = function(a, b) return v2(a.X + b.X, a.Y + b.Y) end
V2mt.__sub = function(a, b) return v2(a.X - b.X, a.Y - b.Y) end
V2mt.__mul = function(a, b)
	if realType(a) == "number" then return v2(a * b.X, a * b.Y) end
	if realType(b) == "number" then return v2(a.X * b, a.Y * b) end
	return v2(a.X * b.X, a.Y * b.Y)
end
V2mt.__div = function(a, b)
	if realType(b) == "number" then return v2(a.X / b, a.Y / b) end
	return v2(a.X / b.X, a.Y / b.Y)
end
V2mt.__unm = function(a) return v2(-a.X, -a.Y) end
V2mt.__eq = function(a, b) return a.X == b.X and a.Y == b.Y end
V2mt.__tostring = function(a) return a.X .. ", " .. a.Y end
V2.new = function(x, y) return v2(num(x, "Vector2.new"), num(y, "Vector2.new")) end
V2.zero, V2.one, V2.xAxis, V2.yAxis = v2(0, 0), v2(1, 1), v2(1, 0), v2(0, 1)

local V3 = {}
local V3mt = { __newindex = ro("Vector3") }
local function v3(x, y, z) return newType("Vector3", { X = x, Y = y, Z = z }, V3mt) end
V3mt.__index = function(s, k)
	if k == "Magnitude" then return math.sqrt(s.X * s.X + s.Y * s.Y + s.Z * s.Z) end
	error(tostring(k) .. " is not a valid member of Vector3", 2)
end
V3mt.__add = function(a, b) return v3(a.X + b.X, a.Y + b.Y, a.Z + b.Z) end
V3mt.__sub = function(a, b) return v3(a.X - b.X, a.Y - b.Y, a.Z - b.Z) end
V3mt.__eq = function(a, b) return a.X == b.X and a.Y == b.Y and a.Z == b.Z end
V3.new = function(x, y, z) return v3(num(x, "Vector3.new"), num(y, "Vector3.new"), num(z, "Vector3.new")) end
V3.zero = v3(0, 0, 0)

local UD = {}
local UDmt = { __newindex = ro("UDim") }
local function udim(s, o) return newType("UDim", { Scale = s, Offset = o }, UDmt) end
UDmt.__index = function(_, k) error(tostring(k) .. " is not a valid member of UDim", 2) end
UDmt.__add = function(a, b) return udim(a.Scale + b.Scale, a.Offset + b.Offset) end
UDmt.__sub = function(a, b) return udim(a.Scale - b.Scale, a.Offset - b.Offset) end
UDmt.__eq = function(a, b) return a.Scale == b.Scale and a.Offset == b.Offset end
UD.new = function(s, o) return udim(num(s, "UDim.new"), num(o, "UDim.new")) end

local U2 = {}
local U2mt = { __newindex = ro("UDim2") }
local function udim2(xs, xo, ys, yo) return newType("UDim2", { X = udim(xs, xo), Y = udim(ys, yo) }, U2mt) end
U2mt.__index = function(s, k)
	if k == "Width" then return rawget(s, "X") elseif k == "Height" then return rawget(s, "Y") end
	if k == "Lerp" then
		return function(a, b, t)
			return udim2(a.X.Scale + (b.X.Scale - a.X.Scale) * t, a.X.Offset + (b.X.Offset - a.X.Offset) * t, a.Y.Scale + (b.Y.Scale - a.Y.Scale) * t, a.Y.Offset + (b.Y.Offset - a.Y.Offset) * t)
		end
	end
	error(tostring(k) .. " is not a valid member of UDim2", 2)
end
U2mt.__add = function(a, b) return udim2(a.X.Scale + b.X.Scale, a.X.Offset + b.X.Offset, a.Y.Scale + b.Y.Scale, a.Y.Offset + b.Y.Offset) end
U2mt.__sub = function(a, b) return udim2(a.X.Scale - b.X.Scale, a.X.Offset - b.X.Offset, a.Y.Scale - b.Y.Scale, a.Y.Offset - b.Y.Offset) end
U2mt.__eq = function(a, b) return a.X == b.X and a.Y == b.Y end
U2mt.__tostring = function(a) return string.format("{%g, %g}, {%g, %g}", a.X.Scale, a.X.Offset, a.Y.Scale, a.Y.Offset) end
U2.new = function(xs, xo, ys, yo)
	if mtype(xs) == "UDim" then return udim2(xs.Scale, xs.Offset, xo.Scale, xo.Offset) end
	return udim2(num(xs, "UDim2.new"), num(xo, "UDim2.new"), num(ys, "UDim2.new"), num(yo, "UDim2.new"))
end
U2.fromScale = function(x, y) return udim2(num(x, "UDim2.fromScale"), 0, num(y, "UDim2.fromScale"), 0) end
U2.fromOffset = function(x, y) return udim2(0, num(x, "UDim2.fromOffset"), 0, num(y, "UDim2.fromOffset")) end

local C3 = {}
local C3mt = { __newindex = ro("Color3") }
local function color(r, g, b) return newType("Color3", { R = r, G = g, B = b }, C3mt) end
local function toHSV(c)
	local r, g, b = c.R, c.G, c.B
	local mx, mn = math.max(r, g, b), math.min(r, g, b)
	local d = mx - mn
	local h = 0
	if d > 0 then
		if mx == r then h = ((g - b) / d) % 6 elseif mx == g then h = (b - r) / d + 2 else h = (r - g) / d + 4 end
		h /= 6
	end
	return h, mx > 0 and d / mx or 0, mx
end
C3mt.__index = function(s, k)
	if k == "Lerp" then return function(a, b, t) return color(a.R + (b.R - a.R) * t, a.G + (b.G - a.G) * t, a.B + (b.B - a.B) * t) end end
	if k == "ToHSV" then return toHSV end
	if k == "ToHex" then return function(c) return string.format("%02x%02x%02x", math.floor(c.R * 255 + 0.5), math.floor(c.G * 255 + 0.5), math.floor(c.B * 255 + 0.5)) end end
	if k == "r" then return s.R elseif k == "g" then return s.G elseif k == "b" then return s.B end
	error(tostring(k) .. " is not a valid member of Color3", 2)
end
C3mt.__eq = function(a, b) return a.R == b.R and a.G == b.G and a.B == b.B end
C3.new = function(r, g, b) return color(num(r, "Color3.new"), num(g, "Color3.new"), num(b, "Color3.new")) end
C3.fromRGB = function(r, g, b) return color(num(r, "Color3.fromRGB") / 255, num(g, "Color3.fromRGB") / 255, num(b, "Color3.fromRGB") / 255) end
C3.fromHex = function(h)
	if realType(h) ~= "string" then error("invalid argument #1 to 'fromHex' (string expected, got " .. mtype(h) .. ")", 2) end
	local s = string.gsub(h, "^#", "")
	if #s == 3 then s = string.gsub(s, "(.)", "%1%1") end
	if #s ~= 6 or not string.match(s, "^%x+$") then error("Unable to convert characters to hex value", 2) end
	return color(tonumber(string.sub(s, 1, 2), 16) / 255, tonumber(string.sub(s, 3, 4), 16) / 255, tonumber(string.sub(s, 5, 6), 16) / 255)
end
C3.fromHSV = function(h, s, v)
	h, s, v = num(h, "fromHSV"), num(s, "fromHSV"), num(v, "fromHSV")
	local i = math.floor(h * 6)
	local f = h * 6 - i
	local p, q, t = v * (1 - s), v * (1 - f * s), v * (1 - (1 - f) * s)
	i %= 6
	if i == 0 then return color(v, t, p) elseif i == 1 then return color(q, v, p) elseif i == 2 then return color(p, v, t)
	elseif i == 3 then return color(p, q, v) elseif i == 4 then return color(t, p, v) end
	return color(v, p, q)
end
C3.toHSV = toHSV

local function seqType(name, kpName, isColor)
	local KP, S = {}, {}
	local KPmt = { __newindex = ro(kpName), __index = function(_, k) error(tostring(k) .. " is not a valid member of " .. kpName, 2) end }
	KP.new = function(t, v, env)
		num(t, kpName .. ".new")
		if isColor then
			if mtype(v) ~= "Color3" then error(kpName .. ".new: Color3 expected, got " .. mtype(v), 2) end
		else
			num(v, kpName .. ".new")
		end
		return newType(kpName, { Time = t, Value = v, Envelope = env or 0 }, KPmt)
	end
	local Smt = { __newindex = ro(name), __index = function(_, k) error(tostring(k) .. " is not a valid member of " .. name, 2) end }
	S.new = function(a, b, c)
		local ks
		if realType(a) == "table" and TAG[a] == nil then
			ks = a
			if #ks < 2 then error(name .. ".new(): table must have at least 2 keypoints", 2) end
			if #ks > 20 then error(name .. ": requires at most 20 keypoints", 2) end
			for i, k in ks do
				if mtype(k) ~= kpName then error(name .. ".new(): expected " .. kpName .. " at index " .. i, 2) end
				if i > 1 and k.Time < ks[i - 1].Time then error(name .. ": all keypoints must be ordered by time", 2) end
			end
			if math.abs(ks[1].Time) > 1e-4 or math.abs(ks[#ks].Time - 1) > 1e-4 then error(name .. " time must start at 0.0 and end at 1.0", 2) end
		elseif b == nil or realType(b) == "number" and c ~= nil then
			ks = { KP.new(0, a), KP.new(1, a) }
		else
			ks = { KP.new(0, a), KP.new(1, b) }
		end
		return newType(name, { Keypoints = table.clone(ks) }, Smt)
	end
	return S, KP
end
local ColorSequence, ColorSequenceKeypoint = seqType("ColorSequence", "ColorSequenceKeypoint", true)
local NumberSequence, NumberSequenceKeypoint = seqType("NumberSequence", "NumberSequenceKeypoint", false)

local NR = { new = function(a, b) return newType("NumberRange", { Min = a, Max = b or a }, {}) end }
