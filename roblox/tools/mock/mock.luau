---------------------------------------------------------------------------------- scheduler
local S = { now = 0, frame = 0, deferred = {}, timers = {}, threadCtx = setmetatable({}, { __mode = "k" }) }
M.S = S
local function curCtx() return S.threadCtx[coroutine.running()] or S.bootCtx end
local function report(co, err)
	local tb = debug.traceback(co, tostring(err))
	finding("error", tb)
end
local function resume(co, ...)
	if coroutine.status(co) ~= "suspended" then return end
	local ok, err = coroutine.resume(co, ...)
	if not ok then report(co, err) end
end
M.resume = resume
local function newThread(fn, ctx)
	local co = realType(fn) == "thread" and fn or coroutine.create(fn)
	S.threadCtx[co] = ctx or curCtx()
	return co
end
local function spawnNow(fn, ...) local co = newThread(fn); resume(co, ...); return co end
local function defer(fn, ...) local co = newThread(fn); table.insert(S.deferred, { co, table.pack(...) }); return co end
local function addTimer(at, co, args)
	local t = S.timers
	local e = { at = at, co = co, args = args, seq = #t }
	local i = #t
	while i > 0 and t[i].at > at do i -= 1 end
	table.insert(t, i + 1, e)
end
local function drain()
	local n = 0
	while #S.deferred > 0 do
		n += 1
		if n > 100000 then finding("error", "deferred queue does not settle"); S.deferred = {}; break end
		local e = table.remove(S.deferred, 1)
		resume(e[1], table.unpack(e[2], 1, e[2].n))
	end
end
M.drain = drain
local task = {}
task.spawn = function(fn, ...) return spawnNow(fn, ...) end
task.defer = function(fn, ...) return defer(fn, ...) end
task.delay = function(t, fn, ...)
	local co = newThread(fn)
	addTimer(S.now + math.max(t or 0, 1 / 60), co, table.pack(...))
	return co
end
task.wait = function(t)
	local co = coroutine.running()
	local t0 = S.now
	addTimer(S.now + math.max(t or 0, 1 / 60), co, { n = 0 })
	coroutine.yield()
	return S.now - t0
end
task.cancel = function(co)
	for i, e in S.timers do if e.co == co then table.remove(S.timers, i); break end end
	pcall(coroutine.close, co)
end
task.synchronize = function() end
task.desynchronize = function() end
local function runTimers()
	while #S.timers > 0 and S.timers[1].at <= S.now + 1e-9 do
		local e = table.remove(S.timers, 1)
		resume(e.co, table.unpack(e.args, 1, e.args.n))
		drain()
	end
end

---------------------------------------------------------------------------------- signals
local Conn = {}
local function newSignal(name)
	local sig = { conns = {}, name = name }
	TAG[sig] = "RBXScriptSignal"
	function sig:Connect(fn)
		if realType(fn) ~= "function" then error("Attempt to connect failed: Passed value is not a function", 2) end
		local c = { Connected = true, fn = fn, ctx = curCtx() }
		TAG[c] = "RBXScriptConnection"
		function c:Disconnect() c.Connected = false; local i = table.find(sig.conns, c); if i then table.remove(sig.conns, i) end end
		c.disconnect = c.Disconnect
		table.insert(sig.conns, c)
		return c
	end
	sig.connect = sig.Connect
	function sig:Once(fn)
		local c
		c = sig:Connect(function(...) c:Disconnect(); fn(...) end)
		return c
	end
	function sig:Wait()
		local co = coroutine.running()
		local c
		c = sig:Connect(function(...) c:Disconnect(); resume(co, ...) end)
		return coroutine.yield()
	end
	function sig:Fire(...) -- engine side (deferred invocation)
		for _, c in table.clone(sig.conns) do
			local co = newThread(function(...) if c.Connected then c.fn(...) end end, c.ctx)
			table.insert(S.deferred, { co, table.pack(...) })
		end
	end
	function sig:FireNow(...)
		sig:Fire(...)
		drain()
	end
	return sig
end
M.newSignal = newSignal

---------------------------------------------------------------------------------- Instances
local CLASSES = API.classes
local INT_PROPS = { ZIndex = true, LayoutOrder = true, DisplayOrder = true, BorderSizePixel = true, FillDirectionMaxCells = true, ScrollBarThickness = true }
local READONLY = { ClassName = true, AbsoluteSize = true, AbsolutePosition = true, AbsoluteRotation = true, AbsoluteCanvasSize = true, AbsoluteWindowSize = true,
	TextBounds = true, TextFits = true, IsLoaded = true, AbsoluteContentSize = true, AbsoluteCellSize = true, AbsoluteCellCount = true, ViewportSize = true,
	UserId = true, LocalPlayer = true, GuiState = true, TouchEnabled = true, KeyboardEnabled = true, MouseEnabled = true, TopbarInset = true, ReducedMotionEnabled = true }
local memberCache = {}
local function member(class, k)
	local key = class .. "." .. k
	local c = memberCache[key]
	if c ~= nil then return c end
	local cl = class
	c = false
	while cl do
		local d = CLASSES[cl]
		if not d then break end
		if d.props[k] then c = { "prop", d.props[k] }; break end
		if d.methods[k] then c = { "method" }; break end
		if d.events[k] then c = { "event" }; break end
		cl = d.super
	end
	memberCache[key] = c
	return c
end
local function isA(class, name)
	local cl = class
	while cl do
		if cl == name then return true end
		cl = CLASSES[cl] and CLASSES[cl].super
	end
	return name == "Instance" and CLASSES[class] ~= nil
end

local DATA = setmetatable({}, { __mode = "k" }) -- proxy -> record
M.DATA = DATA
local METHODS = {} -- name -> function(rec, ...)  (generic Instance methods)
local CLASS_METHODS = {} -- class -> name -> fn
local DEFAULTS = {
	Visible = true, ZIndex = 1, Enabled = true, Archivable = true, AutoButtonColor = true, ResetOnSpawn = true, Scale = 1, Thickness = 1,
	TextSize = 14, AspectRatio = 1, LineHeight = 1, ScrollingEnabled = true, Transparency = 0, Interactable = true, AutoLocalize = true,
}
local function defaultFor(rec, k, t)
	if DEFAULTS[k] ~= nil then return DEFAULTS[k] end
	t = string.gsub(t, "%?$", "")
	if k == "Size" and t == "UDim2" then return (rec.class == "ScreenGui") and nil or udim2(0, 100, 0, 100) end
	if t == "number" then return 0 elseif t == "boolean" or t == "bool" then return false elseif t == "string" or t == "ContentId" then return "" end
	if t == "UDim2" then return udim2(0, 0, 0, 0) elseif t == "UDim" then return udim(0, 0) elseif t == "Vector2" then return v2(0, 0)
	elseif t == "Vector3" then return v3(0, 0, 0) elseif t == "Color3" then return (k == "TextColor3" or k == "BorderColor3") and color(0, 0, 0) or color(1, 1, 1)
	elseif t == "Content" then return ContentT.none elseif t == "Font" then return FontT.new("rbxasset://fonts/families/SourceSansPro.json")
	elseif t == "Rect" then return RectT.new(0, 0, 0, 0) elseif t == "CFrame" then return CF.new()
	elseif t == "NumberSequence" then return NumberSequence.new(0) elseif t == "ColorSequence" then return ColorSequence.new(color(1, 1, 1)) end
	local en = string.match(t, "^Enum(%w+)$")
	if en and enumsByName[en] then
		local DEF = { AutomaticSize = "None", SortOrder = "LayoutOrder", FillDirection = "Vertical", SizeConstraint = "RelativeXY", ScaleType = "Stretch", ZIndexBehavior = "Sibling" }
		local e = enumsByName[en]
		if DEF[en] and e.__items[DEF[en]] then return e.__items[DEF[en]] end
		for _, it in e.__items do if it.Value == 0 then return it end end
		for _, it in e.__items do return it end
	end
	return nil
end

local function checkValue(rec, k, t, v)
	local opt = string.sub(t, -1) == "?"
	local base = opt and string.sub(t, 1, -2) or t
	local function bad()
		error(string.format("Unable to assign property %s. %s expected, got %s", k, base, v == nil and "nil" or mtype(v)), 4)
	end
	if v == nil then
		if opt or base == "Instance" or CLASSES[base] then return nil end
		bad()
	end
	if base == "number" then
		if realType(v) ~= "number" then bad() end
		if v ~= v or v == math.huge or v == -math.huge then finding("warn", string.format("non-finite number written to %s.%s", rec.class, k)) end
		if INT_PROPS[k] then v = math.floor(v) end
		return v
	elseif base == "string" or base == "ContentId" then
		if realType(v) == "number" then return tostring(v) end
		if realType(v) ~= "string" then bad() end
		return v
	elseif base == "boolean" or base == "bool" then
		if realType(v) ~= "boolean" then bad() end
		return v
	end
	local en = string.match(base, "^Enum(%w+)$")
	if en and enumsByName[en] then
		local e = enumsByName[en]
		if mtype(v) == "EnumItem" then
			if v.EnumType ~= e then error(string.format("Unable to assign property %s. EnumItem of type %s expected, got an EnumItem of type %s", k, en, v.EnumType.__name), 4) end
			return v
		elseif realType(v) == "string" then
			local it = e.__items[v]
			if not it then bad() end
			return it
		elseif realType(v) == "number" then
			for _, it in e.__items do if it.Value == v then return it end end
			bad()
		end
		bad()
	end
	if CLASSES[base] and isA(base, "Instance") or base == "Instance" then
		if mtype(v) ~= "Instance" or not isA(DATA[v].class, base) then bad() end
		return v
	end
	if base == "Content" or base == "Font" or base == "UDim2" or base == "UDim" or base == "Vector2" or base == "Vector3" or base == "Color3" or base == "Rect"
		or base == "ColorSequence" or base == "NumberSequence" or base == "NumberRange" or base == "CFrame" then
		if mtype(v) ~= base then bad() end
		if base == "UDim2" then
			local a, b, c, d = v.X.Scale, v.X.Offset, v.Y.Scale, v.Y.Offset
			if a ~= a or b ~= b or c ~= c or d ~= d or math.abs(b) == math.huge or math.abs(d) == math.huge then finding("warn", string.format("non-finite UDim2 written to %s.%s", rec.class, k)) end
		end
		return v
	end
	return v -- unknown type: accept
end

local INST_MT = {}
local function propSignal(rec, k)
	rec.psig = rec.psig or {}
	local s = rec.psig[k]
	if not s then s = newSignal(k); rec.psig[k] = s end
	return s
end
local function fireChanged(rec, k)
	if rec.psig and rec.psig[k] then rec.psig[k]:Fire() end
	if rec.events and rec.events.Changed then rec.events.Changed:Fire(k) end
end
local function getEvent(rec, k)
	rec.events = rec.events or {}
	local s = rec.events[k]
	if not s then s = newSignal(k); rec.events[k] = s end
	return s
end
M.getEvent = function(x, k) return getEvent(rawequal(type(x), "table") and x or DATA[x], k) end

local instIndex, instNewindex
local function newInstance(class, name)
	local u = newproxy(true)
	local mt = getmetatable(u)
	mt.__index = instIndex
	mt.__newindex = instNewindex
	mt.__tostring = function() return DATA[u].props.Name end
	mt.__metatable = "The metatable is locked"
	local rec = { class = class, props = { Name = name or class }, children = {}, attrs = {}, self = u, parent = nil }
	DATA[u] = rec
	TAG[u] = "Instance"
	M.instCount = (M.instCount or 0) + 1
	return u, rec
end
M.newInstance = newInstance

local function setParent(rec, p)
	if rec.destroyed then
		error(string.format("The Parent property of %s is locked, current parent: NULL, new parent %s", rec.props.Name, p and DATA[p].props.Name or "NULL"), 3)
	end
	if rec.lockedParent then error("The Parent property of " .. rec.props.Name .. " is locked", 3) end
	if p ~= nil then
		if mtype(p) ~= "Instance" then error("Unable to assign property Parent. Instance expected, got " .. mtype(p), 3) end
		local a = p
		while a do
			if a == rec.self then error("Attempt to set " .. rec.props.Name .. " as its own ancestor", 3) end
			a = DATA[a].parent
		end
	end
	local old = rec.parent
	if old == p then return end
	if old then
		local orec = DATA[old]
		local i = table.find(orec.children, rec.self)
		if i then table.remove(orec.children, i) end
		if orec.events and orec.events.ChildRemoved then orec.events.ChildRemoved:Fire(rec.self) end
	end
	rec.parent = p
	if p then
		local prec = DATA[p]
		table.insert(prec.children, rec.self)
		if prec.events and prec.events.ChildAdded then prec.events.ChildAdded:Fire(rec.self) end
		if prec.waiters then
			for i = #prec.waiters, 1, -1 do
				local w = prec.waiters[i]
				if w.name == rec.props.Name then table.remove(prec.waiters, i); task.defer(function() resume(w.co, rec.self) end) end
			end
		end
	end
	fireChanged(rec, "Parent")
	if rec.events and rec.events.AncestryChanged then rec.events.AncestryChanged:Fire(rec.self, p) end
end

instIndex = function(u, k)
	local rec = DATA[u]
	local p = rec.props[k]
	if p ~= nil then return p end
	if k == "Parent" then return rec.parent end
	if k == "ClassName" then return rec.class end
	if realType(k) ~= "string" then error("invalid key", 2) end
	local m = member(rec.class, k)
	if m then
		if m[1] == "prop" then
			if rec.getters and rec.getters[k] then return rec.getters[k](rec) end
			local cm = CLASS_METHODS[rec.class]
			if (k == "AbsoluteSize" or k == "AbsolutePosition") then return M.absolute(rec, k) end
			local v = defaultFor(rec, k, m[2])
			return v
		elseif m[1] == "method" then
			local cm = CLASS_METHODS[rec.class]
			local f = (cm and cm[k]) or METHODS[k]
			if not f then
				local cl = CLASSES[rec.class] and CLASSES[rec.class].super
				while cl and not f do f = CLASS_METHODS[cl] and CLASS_METHODS[cl][k]; cl = CLASSES[cl] and CLASSES[cl].super end
			end
			if not f then
				return function() error(string.format("[mock] %s:%s is not implemented by the mock", rec.class, k), 2) end
			end
			return f
		else
			return getEvent(rec, k)
		end
	end
	for _, c in rec.children do
		if DATA[c].props.Name == k then return c end
	end
	error(string.format("%s is not a valid member of %s \"%s\"", tostring(k), rec.class, M.fullName(u)), 2)
end
instNewindex = function(u, k, v)
	local rec = DATA[u]
	if k == "Parent" then setParent(rec, v); M.dirty = true; return end
	local m = member(rec.class, k)
	if not m or m[1] ~= "prop" then
		error(string.format("%s is not a valid member of %s \"%s\"", tostring(k), rec.class, M.fullName(u)), 2)
	end
	if READONLY[k] then error(string.format("Unable to assign property %s. Property is read only", k), 2) end
	if k == "Name" and realType(v) ~= "string" then v = tostring(v) end
	v = checkValue(rec, k, m[2], v)
	local old = rec.props[k]
	rec.props[k] = v
	M.dirty = true
	if old ~= v then fireChanged(rec, k) end
	if rec.setters and rec.setters[k] then rec.setters[k](rec, v) end
end

function M.fullName(u)
	local parts = {}
	local a = u
	while a and DATA[a].class ~= "DataModel" do table.insert(parts, 1, DATA[a].props.Name); a = DATA[a].parent end
	return table.concat(parts, ".")
end

-- generic methods ----------------------------------------------------------------
METHODS.IsA = function(u, n) return isA(DATA[u].class, n) end
METHODS.GetChildren = function(u) return table.clone(DATA[u].children) end
METHODS.GetDescendants = function(u)
	local out = {}
	local function rec(x) for _, c in DATA[x].children do table.insert(out, c); rec(c) end end
	rec(u)
	return out
end
METHODS.FindFirstChild = function(u, n, recursive)
	for _, c in DATA[u].children do if DATA[c].props.Name == n then return c end end
	if recursive then for _, c in DATA[u].children do local r = METHODS.FindFirstChild(c, n, true); if r then return r end end end
	return nil
end
METHODS.FindFirstChildOfClass = function(u, cl)
	for _, c in DATA[u].children do if DATA[c].class == cl then return c end end
	return nil
end
METHODS.FindFirstChildWhichIsA = function(u, cl)
	for _, c in DATA[u].children do if isA(DATA[c].class, cl) then return c end end
	return nil
end
METHODS.FindFirstAncestorOfClass = function(u, cl)
	local a = DATA[u].parent
	while a do if DATA[a].class == cl then return a end; a = DATA[a].parent end
	return nil
end
METHODS.IsDescendantOf = function(u, anc)
	local a = DATA[u].parent
	while a do if a == anc then return true end; a = DATA[a].parent end
	return false
end
METHODS.GetFullName = function(u) return M.fullName(u) end
METHODS.WaitForChild = function(u, n, timeout)
	if realType(n) ~= "string" then error("Argument 1 missing or nil", 2) end
	local c = METHODS.FindFirstChild(u, n)
	if c then return c end
	local rec = DATA[u]
	rec.waiters = rec.waiters or {}
	local co = coroutine.running()
	local w = { name = n, co = co }
	table.insert(rec.waiters, w)
	local tb = debug.traceback("", 2)
	if timeout then
		task.delay(timeout, function()
			local i = table.find(rec.waiters, w)
			if i then table.remove(rec.waiters, i); resume(co, nil) end
		end)
	else
		task.delay(5, function()
			if table.find(rec.waiters, w) then finding("warn", string.format("Infinite yield possible on '%s:WaitForChild(\"%s\")'%s", M.fullName(u), n, tb)) end
		end)
	end
	return coroutine.yield()
end
METHODS.GetAttribute = function(u, n) return DATA[u].attrs[n] end
METHODS.GetAttributes = function(u) return table.clone(DATA[u].attrs) end
METHODS.SetAttribute = function(u, n, v)
	local t = mtype(v)
	if not (v == nil or t == "string" or t == "number" or t == "boolean" or t == "UDim" or t == "UDim2" or t == "Vector2" or t == "Vector3" or t == "Color3"
		or t == "ColorSequence" or t == "NumberSequence" or t == "NumberRange" or t == "Rect" or t == "Font" or t == "EnumItem" or t == "CFrame") then
		error("SetAttribute: type " .. t .. " is not supported", 2)
	end
	DATA[u].attrs[n] = v
	local rec = DATA[u]
	if rec.asig and rec.asig[n] then rec.asig[n]:Fire() end
end
METHODS.GetAttributeChangedSignal = function(u, n)
	local rec = DATA[u]
	rec.asig = rec.asig or {}
	rec.asig[n] = rec.asig[n] or newSignal(n)
	return rec.asig[n]
end
METHODS.GetPropertyChangedSignal = function(u, k)
	local rec = DATA[u]
	local m = member(rec.class, k)
	if not m or m[1] ~= "prop" then error(string.format("%s is not a valid property name.", tostring(k)), 2) end
	return propSignal(rec, k)
end
local function destroy(u)
	local rec = DATA[u]
	if rec.destroyed then return end
	for _, c in table.clone(rec.children) do destroy(c) end
	if rec.events and rec.events.Destroying then rec.events.Destroying:Fire() end
	if rec.parent then setParent(rec, nil) end
	rec.destroyed = true
	if rec.onDestroy then rec.onDestroy(rec) end
	-- disconnects every connection of this instance's events
	for _, s in rec.events or {} do for _, c in table.clone(s.conns) do c:Disconnect() end end
	for _, s in rec.psig or {} do for _, c in table.clone(s.conns) do c:Disconnect() end end
end
METHODS.Destroy = function(u) destroy(u) end
METHODS.ClearAllChildren = function(u) for _, c in table.clone(DATA[u].children) do destroy(c) end end
METHODS.Clone = function(u)
	local rec = DATA[u]
	local c, crec = newInstance(rec.class)
	for k, v in rec.props do crec.props[k] = v end
	for k, v in rec.attrs do crec.attrs[k] = v end
	crec.source, crec.native = rec.source, rec.native
	for _, ch in rec.children do local cc = METHODS.Clone(ch); setParent(DATA[cc], c) end
	return c
end
METHODS.AddTag = function() end
METHODS.HasTag = function() return false end

local InstanceG = {}
InstanceG.new = function(class, parent)
	if realType(class) ~= "string" then error("Argument 1 missing or nil", 2) end
	if not API.creatable[class] then error(string.format("Unable to create an Instance of type \"%s\"", class), 2) end
	local u, rec = newInstance(class)
	if M.onCreate[class] then M.onCreate[class](rec) end
	if parent then u.Parent = parent end
	return u
end
M.onCreate = {}
M.CLASS_METHODS = CLASS_METHODS

---------------------------------------------------------------------------------- simple layout (scale/offset/anchor/padding/UIScale)
M.viewport = v2(1400, 850)
M.INSET = 58
local function guiRect(rec)
	-- returns x, y, w, h in inset space (same space as InputObject.Position)
	if rec.class == "ScreenGui" then
		local ign = rec.props.IgnoreGuiInset == true
		if ign then return 0, -M.INSET, M.viewport.X, M.viewport.Y end
		return 0, 0, M.viewport.X, M.viewport.Y - M.INSET
	end
	local p = rec.parent
	if not p or not isA(DATA[p].class, "GuiBase2d") then return 0, 0, 0, 0 end
	local prec = DATA[p]
	local px, py, pw, ph = guiRect(prec)
	local pad = METHODS.FindFirstChildOfClass(p, "UIPadding")
	if pad then
		local pr = DATA[pad].props
		local function u(x, total) return x and (x.Scale * total + x.Offset) or 0 end
		local l, r, t, b = u(pr.PaddingLeft, pw), u(pr.PaddingRight, pw), u(pr.PaddingTop, ph), u(pr.PaddingBottom, ph)
		px, py, pw, ph = px + l, py + t, pw - l - r, ph - t - b
	end
	if prec.class == "ScrollingFrame" then
		local cp = prec.props.CanvasPosition
		if cp then px -= cp.X; py -= cp.Y end
	end
	local pr = rec.props
	local size = pr.Size or udim2(0, 100, 0, 100)
	local pos = pr.Position or udim2(0, 0, 0, 0)
	local ap = pr.AnchorPoint or V2.zero
	local sw, sh = pw, ph
	local sc = pr.SizeConstraint
	if sc and sc.Name == "RelativeXX" then sh = pw elseif sc and sc.Name == "RelativeYY" then sw = ph end
	local w, h = size.X.Scale * sw + size.X.Offset, size.Y.Scale * sh + size.Y.Offset
	local ar = METHODS.FindFirstChildOfClass(rec.self, "UIAspectRatioConstraint")
	if ar then local a = DATA[ar].props.AspectRatio or 1; h = w / a end
	local us = METHODS.FindFirstChildOfClass(rec.self, "UIScale")
	if us then local s = DATA[us].props.Scale or 1; w *= s; h *= s end
	local x = px + pos.X.Scale * pw + pos.X.Offset - ap.X * w
	local y = py + pos.Y.Scale * ph + pos.Y.Offset - ap.Y * h
	return x, y, w, h
end
M.guiRect = guiRect
function M.absolute(rec, k)
	local x, y, w, h = guiRect(rec)
	if k == "AbsoluteSize" then return v2(w, h) end
	return v2(x, y)
end

---------------------------------------------------------------------------------- remote argument serialization
local function ser(v, path, seen)
	local t = mtype(v)
	if t == "function" then finding("warn", "function sent through a remote at " .. path .. " (received as nil)"); return nil end
	if t == "table" then
		if seen[v] then error("tables cannot be cyclic", 0) end
		seen[v] = true
		local n = #v
		local hasStr, hasNum, sparse = false, false, false
		for k in v do
			if realType(k) == "number" then hasNum = true; if k < 1 or k > n or k % 1 ~= 0 then sparse = true end else hasStr = true end
		end
		local out = {}
		if hasNum and hasStr then finding("warn", "mixed table (array + dictionary keys) sent through a remote at " .. path) end
		if sparse then finding("warn", "sparse array sent through a remote at " .. path) end
		for k, x in v do
			local kk = k
			if realType(k) ~= "string" and realType(k) ~= "number" then kk = tostring(k); finding("warn", "non-string key sent through a remote at " .. path) end
			out[kk] = ser(x, path .. "." .. tostring(k), seen)
		end
		seen[v] = nil
		return out
	end
	return v
end
M.ser = function(...)
	local a = table.pack(...)
	for i = 1, a.n do a[i] = ser(a[i], "arg" .. i, {}) end
	return a
end

