local RandomT = { new = function(seed)
	local s = seed or 1
	local function nxt() s = (s * 1103515245 + 12345) % 2147483648; return s / 2147483648 end
	local r = {}
	r.NextNumber = function(_, a, b) local x = nxt(); if a then return a + (b - a) * x end return x end
	r.NextInteger = function(_, a, b) return a + math.floor(nxt() * (b - a + 1)) end
	TAG[r] = "Random"
	return r
end }

---------------------------------------------------------------------------------- Enums
local EnumItemMt = {}
local enumsByName = {}
local EnumRoot = {}
local KNOWN_VALUES = { ContextActionPriority = { Low = 1000, Medium = 2000, High = 3000 } }
local function makeEnum(name, items)
	local e = { __items = {}, __name = name }
	for i, it in items do
		local v = (KNOWN_VALUES[name] and KNOWN_VALUES[name][it]) or (i - 1)
		local item = newType("EnumItem", { Name = it, Value = v, EnumType = e }, EnumItemMt)
		e.__items[it] = item
	end
	TAG[e] = "Enum"
	return setmetatable(e, {
		__index = function(self, k)
			if k == "GetEnumItems" then return function() local l = {}; for _, it in self.__items do table.insert(l, it) end; return l end end
			if k == "FromName" then return function(_, n) return self.__items[n] end end
			local it = rawget(self, "__items")[k]
			if it == nil then error(tostring(k) .. " is not a valid member of \"Enum." .. name .. "\"", 2) end
			return it
		end,
		__tostring = function() return name end,
	})
end
EnumItemMt.__tostring = function(s) return "Enum." .. s.EnumType.__name .. "." .. s.Name end
EnumItemMt.__index = function(s, k)
	if k == "IsA" then return function(it, n) return it.EnumType.__name == n end end
	error(tostring(k) .. " is not a valid member of EnumItem", 2)
end
for name, items in API.enums do
	if name == "KeyCode" and not table.find(items, "Unknown") then table.insert(items, 1, "Unknown") end
	enumsByName[name] = makeEnum(name, items)
end
local EnumG = setmetatable({}, { __index = function(_, k)
	local e = enumsByName[k]
	if not e then error(tostring(k) .. " is not a valid member of \"Enums\"", 2) end
	return e
end })
TAG[EnumG] = "Enums"

FontT.new = function(family, weight, style)
	if realType(family) ~= "string" then error("Font.new: string expected", 2) end
	return newType("Font", { Family = family, Weight = weight or EnumG.FontWeight.Regular, Style = style or EnumG.FontStyle.Normal, Bold = false }, Fmt)
end
FontT.fromEnum = function(e) return FontT.new("rbxasset://fonts/families/" .. e.Name .. ".json") end
FontT.fromName = function(n, w, s) return FontT.new("rbxasset://fonts/families/" .. n .. ".json", w, s) end
ContentT.fromObject = function(o)
	if mtype(o) ~= "EditableImage" and mtype(o) ~= "Instance" then error("Content.fromObject: object expected, got " .. mtype(o), 2) end
	return newType("Content", { SourceType = "Object", Object = o }, Contentmt)
end
ContentT.fromUri = function(u) return newType("Content", { SourceType = "Uri", Uri = u }, Contentmt) end
